// F12 Salon Appointment Dashboard — core measures
Total Appointments = COUNTROWS(FactAppointments)
Completed Appointments = CALCULATE([Total Appointments], FactAppointments[Status] = "Completed")
Cancelled Appointments = CALCULATE([Total Appointments], FactAppointments[Status] = "Cancelled")
No-show Appointments = CALCULATE([Total Appointments], FactAppointments[Status] = "No-show")
Completion Rate = DIVIDE([Completed Appointments], [Total Appointments])
Cancellation Rate = DIVIDE([Cancelled Appointments], [Total Appointments])
No-show Rate = DIVIDE([No-show Appointments], [Total Appointments])
Net Revenue = SUM(FactAppointments[NetRevenue])
Average Ticket = DIVIDE([Net Revenue], [Completed Appointments])
Unique Customers = CALCULATE(DISTINCTCOUNT(FactAppointments[CustomerID]), FactAppointments[Status] = "Completed")
Booked Hours = DIVIDE(SUM(FactAppointments[BookedMinutes]), 60)
Completed Service Hours = DIVIDE(CALCULATE(SUM(FactAppointments[BookedMinutes]), FactAppointments[Status] = "Completed"), 60)
Revenue PM = CALCULATE([Net Revenue], DATESMTD(DimDate[Date]))
Revenue Previous Month = CALCULATE([Net Revenue], DATEADD(DimDate[Date], -1, MONTH))
Revenue MoM % = DIVIDE([Net Revenue] - [Revenue Previous Month], [Revenue Previous Month])
Revenue per Completed Hour = DIVIDE([Net Revenue], [Completed Service Hours])
Average Booking Lead Days = AVERAGEX(FactAppointments, DATEDIFF(FactAppointments[BookingDate], FactAppointments[AppointmentDate], DAY))
Average Discount Rate = AVERAGE(FactAppointments[DiscountPct])
Repeat Customers = CALCULATE(DISTINCTCOUNT(FactAppointments[CustomerID]), FactAppointments[Status] = "Completed", DimCustomer[CustomerType] = "Returning")
Repeat Customer Rate = DIVIDE([Repeat Customers], [Unique Customers])
