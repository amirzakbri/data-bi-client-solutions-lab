// Correct measures — use the marked, contiguous DimDate table
+Total Revenue = SUM ( Sales[Revenue] )
+Total Cost = SUM ( Sales[Cost] )
+Gross Profit = [Total Revenue] - [Total Cost]
+Gross Margin % = DIVIDE ( [Gross Profit], [Total Revenue] )
+Units Sold = SUM ( Sales[Quantity] )
+Revenue YTD = TOTALYTD ( [Total Revenue], DimDate[Date] )
+Revenue Previous Month = CALCULATE ( [Total Revenue], DATEADD ( DimDate[Date], -1, MONTH ) )
+Revenue MoM % = DIVIDE ( [Total Revenue] - [Revenue Previous Month], [Revenue Previous Month] )
+Revenue Prior Year = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
+Revenue YoY % = DIVIDE ( [Total Revenue] - [Revenue Prior Year], [Revenue Prior Year] )
+Revenue Rolling 12M =
+VAR LastVisibleDate = MAX ( DimDate[Date] )
+RETURN CALCULATE ( [Total Revenue], DATESINPERIOD ( DimDate[Date], LastVisibleDate, -12, MONTH ) )
+Latest Complete Month Revenue =
+VAR LastDataDate = CALCULATE ( MAX ( Sales[OrderDate] ), REMOVEFILTERS ( DimDate ) )
+VAR MonthEnd = EOMONTH ( LastDataDate, 0 )
+RETURN CALCULATE ( [Total Revenue], DATESBETWEEN ( DimDate[Date], DATE ( YEAR ( MonthEnd ), MONTH ( MonthEnd ), 1 ), MonthEnd ) )
+